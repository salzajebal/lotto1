# VPS 애플리케이션 런타임
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://lotto_app:CHANGE_ME@127.0.0.1:5432/lotto_analysis
SESSION_SECRET=CHANGE_TO_A_LONG_RANDOM_VALUE

# 선택 사항: 기본 프론트엔드 빌드 경로를 바꿀 때만 사용
# WEB_DIST_DIR=/var/www/lotto-analysis/artifacts/lotto-analysis-home/dist/public

# 수동 데이터 이전 시에만 현재 셸에서 별도로 지정합니다.
# SOURCE_DATABASE_URL=postgresql://source_user:source_password@source_host:5432/source_db
# TARGET_DATABASE_URL=postgresql://lotto_app:target_password@127.0.0.1:5432/lotto_analysis